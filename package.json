{
  "name": "dsh",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=@dsh/frontend",
    "dev:backend": "npm run dev --workspace=@dsh/backend",
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "start:frontend": "npm run start --workspace=@dsh/frontend",
    "start:backend": "npm run start --workspace=@dsh/backend",
    "lint:frontend": "npm run lint --workspace=@dsh/frontend",
    "lint:backend": "npm run lint --workspace=@dsh/backend",
    "lint": "npm run lint --workspaces",
    "typecheck:frontend": "npm run typecheck --workspace=@dsh/frontend",
    "typecheck:backend": "npm run typecheck --workspace=@dsh/backend",
    "typecheck": "npm run typecheck --workspaces",
    "db:check": "npm run db:check --workspace=@dsh/backend",
    "db:generate": "npm run db:generate --workspace=@dsh/backend",
    "db:migrate": "npm run db:migrate --workspace=@dsh/backend",
    "db:studio": "npm run db:studio --workspace=@dsh/backend"
  }
}
