# ==============================================================================
# DIGITAL SERVICES HUB (DSH) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SAFETY WARNING: Never commit real credentials or production secrets to Git.
# Copy this file to .env.local for local development.
# ==============================================================================

# Application Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Docker local or hosted)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://dsh_user:dsh_dev_password@localhost:5432/dsh_db

# Session & Security
# Generate a secure 32+ character random hex or base64 string
SESSION_SECRET=replace_with_secure_random_at_least_32_chars_secret_for_sessions

# Safaricom Daraja M-Pesa API
# Use 'sandbox' for development and testing; 'production' for live deployment
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=daraja_sandbox_consumer_key_placeholder
MPESA_CONSUMER_SECRET=daraja_sandbox_consumer_secret_placeholder
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_SHORTCODE=174379
# Must be publicly accessible HTTPS URL in production, or ngrok/localtunnel for local webhook testing
MPESA_CALLBACK_URL=https://example.com/api/payments/mpesa/callback

# Transaction Confirmation & Notifications (Resend)
RESEND_API_KEY=re_placeholder_development_api_key
EMAIL_FROM=Digital Services Hub <noreply@yourdomain.com>

# HotSpot Gateway Settings (Simulated vs Real MikroTik/Omada)
# When true, network authorization is simulated locally for offline testing
GATEWAY_SIMULATED=true
MIKROTIK_HOST=
MIKROTIK_USER=
MIKROTIK_PASSWORD=
MIKROTIK_PORT=8728
